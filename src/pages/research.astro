---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PublicationItem from "@/components/PublicationItem.astro";
import { getProfile, getPublications } from "@/lib/content";

const profile = await getProfile();
const { papers, ongoing } = await getPublications();
---

<BaseLayout title="Research" description={profile.researchStatement}>
  <div class="py-16 md:py-20">
    <header>
      <p class="font-mono text-sm text-muted">Research</p>
      <h1 class="mt-2 text-3xl font-semibold">Publications, ongoing work & interests</h1>
      <p class="mt-4 max-w-prose leading-relaxed">{profile.researchStatement}</p>
    </header>

    {
      ongoing.length > 0 && (
        <section class="mt-14 border-t border-border pt-8" aria-labelledby="ongoing-heading">
          <h2 id="ongoing-heading" class="text-xl font-semibold">Ongoing work</h2>
          <ul class="mt-7 space-y-10">
            {ongoing.map((publication) => (
              <li>
                <PublicationItem publication={publication} highlight={profile.name} detailed />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-14 border-t border-border pt-8" aria-labelledby="publications-heading">
      <h2 id="publications-heading" class="text-xl font-semibold">Publications</h2>
      {
        papers.length > 0 ? (
          <ul class="mt-7 space-y-10">
            {papers.map((publication) => (
              <li>
                <PublicationItem publication={publication} highlight={profile.name} detailed />
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 text-muted">No publications listed yet.</p>
        )
      }
    </section>

    <section class="mt-14 border-t border-border pt-8" aria-labelledby="interests-heading">
      <h2 id="interests-heading" class="text-xl font-semibold">Research interests</h2>
      <ul class="mt-7 grid gap-6 sm:grid-cols-2">
        {profile.researchInterests.map((interest) => (
          <li>
            <h3 class="font-semibold">{interest.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{interest.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
