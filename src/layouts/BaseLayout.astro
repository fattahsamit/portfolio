---
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getProfile, getEducation } from "@/lib/content";
import "@/styles/global.css";

interface Props {
  /** Page title. Omit on the home page to use the full name + tagline. */
  title?: string;
  description?: string;
  /** Path (from /public) or absolute URL of the social share image. */
  image?: string;
  type?: "website" | "article" | "profile";
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Extra JSON-LD objects for this page (the Person schema is always included). */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const profile = await getProfile();
const education = await getEducation();

const {
  title,
  description = `${profile.tagline} ${profile.intro.split(". ")[0]}.`,
  image = "/og.png",
  type = "website",
  publishedTime,
  modifiedTime,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${profile.shortName}` : `${profile.name} · SQA Automation Engineer & Researcher`;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;

const sameAs = Object.values(profile.links).filter(Boolean);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": new URL("/#person", site).href,
  name: profile.name,
  alternateName: profile.shortName,
  url: site.href,
  image: imageUrl,
  email: `mailto:${profile.email}`,
  jobTitle: profile.currentRole.split(" at ")[0],
  worksFor: profile.currentRole.includes(" at ")
    ? { "@type": "Organization", name: profile.currentRole.split(" at ")[1] }
    : undefined,
  address: { "@type": "PostalAddress", addressLocality: profile.location.split(",")[0]?.trim(), addressCountry: "BD" },
  alumniOf: education.map((e) => ({ "@type": "EducationalOrganization", name: e.data.institution })),
  knowsAbout: profile.interests,
  sameAs,
};
const structuredData = jsonLd.length ? [person, ...jsonLd] : person;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="theme-color" content="#ffffff" />
    <!-- Theme: runs before first paint so there is no flash of the wrong theme. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.classList.toggle("dark", dark);
        root.style.colorScheme = dark ? "dark" : "light";
        document.querySelector('meta[name="theme-color"]').content = dark ? "#09090b" : "#ffffff";
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.tagline}`} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-contrast focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-4xl flex-1 px-5 outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      // Fade/slide sections in as they enter the viewport (CSS skips this for reduced motion).
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
