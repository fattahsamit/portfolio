---
import Icon from "./Icon.astro";
import type { Publication } from "@/lib/content";

interface Props {
  publication: Publication;
  /** Name to highlight in the author list. */
  highlight: string;
  /** Show the summary paragraph (on /research, hidden in previews). */
  detailed?: boolean;
  headingLevel?: "h3" | "h4";
}

const { publication, highlight, detailed = false, headingLevel: Heading = "h3" } = Astro.props;
const { title, authors, venue, year, type, status, summary, links, tags } = publication.data;

const typeLabel: Record<typeof type, string> = {
  journal: "Journal",
  conference: "Conference",
  preprint: "Preprint",
  thesis: "Thesis",
  report: "Report",
  workshop: "Workshop",
};
const statusLabel = status === "under-review" ? "Under review" : status === "in-progress" ? "In progress" : null;

const doiUrl = links.doi && !links.doi.startsWith("http") ? `https://doi.org/${links.doi}` : links.doi;
const primary = doiUrl ?? links.url ?? links.pdf;
const linkList = [
  links.pdf && { label: "PDF", href: links.pdf },
  doiUrl && { label: "DOI", href: doiUrl },
  links.url && { label: "Record", href: links.url },
  links.code && { label: "Code", href: links.code },
  links.slides && { label: "Slides", href: links.slides },
].filter((l): l is { label: string; href: string } => Boolean(l));
---

<article class="group">
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-muted">
    <span>{year}</span>
    <span aria-hidden="true">·</span>
    <span>{typeLabel[type]}</span>
    {
      statusLabel && (
        <span class="rounded border border-accent/40 bg-accent-soft px-1.5 py-px text-accent">{statusLabel}</span>
      )
    }
  </p>
  <Heading class="mt-1.5 text-base leading-snug font-semibold">
    {
      primary ? (
        <a href={primary} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
          {title}
        </a>
      ) : (
        title
      )
    }
  </Heading>
  <p class="mt-1 text-[15px] text-muted">
    {
      authors.map((a, i) => (
        <>
          {a === highlight ? <strong class="font-medium text-fg">{a}</strong> : a}
          {i < authors.length - 1 && ", "}
        </>
      ))
    }
  </p>
  <p class="mt-0.5 text-[15px] text-muted italic">{venue}</p>
  {detailed && summary && <p class="mt-3 max-w-prose text-[15px] leading-relaxed">{summary}</p>}
  {
    detailed && tags.length > 0 && (
      <p class="mt-2 font-mono text-xs text-muted">{tags.join(" · ")}</p>
    )
  }
  {
    linkList.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {linkList.map((l) => (
          <li>
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 rounded-md border border-border px-2 py-0.5 font-mono text-xs text-fg transition-colors hover:border-accent hover:text-accent"
            >
              {l.label}
              <span class="sr-only">: {title}</span>
              <Icon name="arrow-up-right" class="size-3" />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
