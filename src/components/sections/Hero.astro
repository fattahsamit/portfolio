---
import ButtonLink from "@/components/ButtonLink.astro";
import Icon from "@/components/Icon.astro";
import type { Profile } from "@/lib/content";

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
---

<section aria-labelledby="hero-heading" class="pt-16 pb-16 md:pt-28 md:pb-24">
  <p class="font-mono text-sm text-accent">Software QA · Test automation · Research</p>
  <h1 id="hero-heading" class="mt-4 text-4xl leading-[1.1] font-semibold sm:text-5xl md:text-6xl">
    {profile.name}
  </h1>
  <p class="mt-4 text-xl text-muted sm:text-2xl">{profile.tagline}</p>
  <p class="mt-6 max-w-2xl text-base leading-relaxed sm:text-lg">{profile.intro}</p>

  <div class="mt-8 flex flex-wrap gap-3">
    {
      profile.resume && (
        <ButtonLink href={profile.resume} variant="primary">
          <Icon name="file" /> Resume
        </ButtonLink>
      )
    }
    <ButtonLink href="#contact" variant={profile.resume ? "secondary" : "primary"}>
      <Icon name="mail" /> Contact
    </ButtonLink>
    {
      profile.links.github && (
        <ButtonLink href={profile.links.github}>
          <Icon name="github" /> GitHub
        </ButtonLink>
      )
    }
  </div>
</section>
