---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getNotes, getProfile } from "@/lib/content";

const profile = await getProfile();
const hasNotes = (await getNotes()).length > 0;

const nav = [
  { label: "About", href: "/#about" },
  { label: "Experience", href: "/#experience" },
  { label: "Projects", href: "/#projects" },
  { label: "Research", href: "/research" },
  ...(hasNotes ? [{ label: "Notes", href: "/notes" }] : []),
  { label: "Contact", href: "/#contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => !href.includes("#") && path.startsWith(href);
const linkClass =
  "rounded-md px-2.5 py-1.5 text-sm text-muted transition-colors hover:text-fg aria-[current=page]:text-fg aria-[current=page]:font-medium";
---

<header
  class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70"
>
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-4xl items-center justify-between gap-4 px-5">
    <a href="/" class="text-[15px] font-semibold tracking-tight" aria-label={`${profile.name}, home`}>
      {profile.shortName}
    </a>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-0.5 md:flex">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class={linkClass} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <ThemeToggle />

      <button
        id="menu-toggle"
        type="button"
        class="group inline-flex size-9 items-center justify-center rounded-lg text-muted transition-colors hover:bg-surface hover:text-fg md:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Menu"
      >
        <Icon name="menu" class="size-5 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden size-5 group-aria-expanded:block" />
      </button>
    </div>
  </nav>

  <div id="mobile-nav" class="border-t border-border md:hidden" hidden>
    <ul class="mx-auto flex max-w-4xl flex-col px-3 py-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-md px-2 py-2.5 text-[15px] text-muted hover:text-fg aria-[current=page]:text-fg"
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
  }

  toggle?.addEventListener("click", () => setOpen(panel?.hidden ?? false));
  panel?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia("(min-width: 48rem)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
